# Application Settings
PROJECT_NAME="LexFlow AI"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (SQLite)
DATABASE_URL="sqlite:///./lexflow.db"

# Security & Authentication (Generate secure secret for production)
SECRET_KEY="replace-with-a-secure-random-32-byte-hex-string-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Storage & Upload Configuration
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_BYTES=15728640

# CORS Configuration (React frontend origins: Vite: 5173, CRA: 3000)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]
